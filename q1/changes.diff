diff -ruN xv6-orig/vm.c xv6-q1/vm.c
--- xv6-orig/vm.c	2026-10-27 16:04:23.876270903 +0530
+++ xv6-q1/vm.c	2026-10-27 16:01:07.690768400 +0530
@@ -392,3 +392,42 @@
 //PAGEBREAK!
 // Blank page.
 
+
+// Q1: print the page table of the calling process.
+// Walks the page directory the same way freevm() does (over all PDEs) but
+// only looks at the user part of the address space (< KERNBASE).
+// For every valid (PTE_P) user page prints: virtual address, physical
+// address of the frame, and the flags P, W, U (1 = set, 0 = clear).
+// At the end prints the number of valid user pages and the number of
+// page-table pages (second-level tables) plus the page directory itself.
+int
+vmprint(void)
+{
+  pde_t *pgdir = myproc()->pgdir;
+  pte_t *pgtab, *pte;
+  uint i, j, va;
+  int npages = 0, nptpages = 0;
+
+  cprintf("page table of pid %d (%s)\n", myproc()->pid, myproc()->name);
+  cprintf("  VA          PA          P W U\n");
+  for(i = 0; i < PDX(KERNBASE); i++){       // user part only
+    if(!(pgdir[i] & PTE_P))
+      continue;
+    nptpages++;                              // one second-level table
+    pgtab = (pte_t*)P2V(PTE_ADDR(pgdir[i]));
+    for(j = 0; j < NPTENTRIES; j++){
+      pte = &pgtab[j];
+      if(!(*pte & PTE_P))
+        continue;
+      va = (i << PDXSHIFT) | (j << PTXSHIFT);
+      cprintf("  0x%x  0x%x  %d %d %d\n", va, PTE_ADDR(*pte),
+              (*pte & PTE_P) ? 1 : 0, (*pte & PTE_W) ? 1 : 0,
+              (*pte & PTE_U) ? 1 : 0);
+      npages++;
+    }
+  }
+  cprintf("valid user pages: %d\n", npages);
+  cprintf("page-table pages: %d second-level + 1 page directory = %d\n",
+          nptpages, nptpages + 1);
+  return npages;
+}
