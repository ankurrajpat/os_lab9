     lapiceoi();
     break;
 
+  // Q2: page fault handler for lazy allocation.
+  case T_PGFLT: {
+    uint va = rcr2();               // faulting virtual address
+    struct proc *p = myproc();
+    char *mem;
+    // Only handle faults from user mode on a *not present* page below sz.
+    // (tf->err & 1) set means protection violation on a present page: kill.
+    if(p != 0 && (tf->cs&3) == DPL_USER && !(tf->err & 1) && va < p->sz){
+      mem = kalloc();
+      if(mem == 0){
+        cprintf("pid %d: lazy alloc out of memory, killing\n", p->pid);
+        p->killed = 1;
+        break;
+      }
+      memset(mem, 0, PGSIZE);       // zero-filled page
+      if(mappages(p->pgdir, (char*)PGROUNDDOWN(va), PGSIZE, V2P(mem),
+                  PTE_W|PTE_U) < 0){
+        kfree(mem);
+        p->killed = 1;
+        break;
+      }
+      p->pgfaults++;                // count the handled fault
+      break;                        // resume the process at the same instruction
+    }
+    if(p == 0 || (tf->cs&3) == 0){
+      cprintf("unexpected page fault in kernel eip %x addr 0x%x\n", tf->eip, va);
+      panic("trap");
+    }
+    // Address at or above sz (or protection fault): kill only this process.
+    cprintf("pid %d: page fault at invalid address 0x%x -- killing process\n",
+            p->pid, va);
+    p->killed = 1;
+    break;
+  }
+
